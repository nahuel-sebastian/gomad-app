      "title": "Covered"
     },
     "municipality": {
      "type": "string",
      "title": "Municipality"
     },
     "ine_code": {
      "type": "string",
      "title": "Ine Code"
     },
     "coordinate": {
      "$ref": "#/components/schemas/Coordinate"
     },
     "source": {
      "$ref": "#/components/schemas/DataSource"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "id",
     "name",
     "type",
     "covered",
     "municipality",
     "ine_code",
     "coordinate",
     "source"
    ],
    "title": "DestinationSummary"
   },
   "FactorScore": {
    "properties": {
     "factor": {
      "type": "string",
      "enum": [
       "proximity",
       "suitability",
       "green",
       "air",
       "weather"
      ],
      "title": "Factor"
     },
     "value": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 10.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     },
     "weight": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Weight"
     },
     "text": {
      "type": "string",
      "title": "Text"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "factor",
     "value",
     "weight",
     "text"
    ],
    "title": "FactorScore"
