       },
       {
        "type": "null"
       }
      ],
      "title": "Aqi Category"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "hour",
     "score",
     "outdoor_ok",
     "reasons",
     "temperature_c",
     "feels_like_c",
     "precip_prob",
     "aqi_category"
    ],
    "title": "HourEvaluation"
   },
   "Indicator": {
