       "$ref": "#/components/schemas/Activity"
      },
      "type": "array",
      "title": "Activities"
     },
     "profiles": {
      "items": {
       "type": "string",
       "enum": [
        "general",
        "senior",
        "stroller",
        "sensitive"
       ]
      },
      "type": "array",
      "title": "Profiles"
     },
     "companions": {
      "items": {
       "type": "string",
       "enum": [
        "dog",
        "kids"
       ]
      },
      "type": "array",
      "title": "Companions"
     },
     "default_weights": {
      "$ref": "#/components/schemas/Weights"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "activities",
     "profiles",
     "companions",
     "default_weights"
    ],
    "title": "ActivitiesResponse"
   },
   "Activity": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "icon": {
      "type": "string",
      "title": "Icon"
     },
     "outdoor": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Outdoor"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "id",
     "label",
     "icon",
     "outdoor"
    ],
    "title": "Activity"
   },
   "AssistantParams": {
    "properties": {
     "activity": {
      "type": "string",
      "enum": [
       "walk",
       "run"
      ],
      "title": "Activity"
     },
     "distance_km": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 42.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Distance Km"
     },
     "duration_min": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 480.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Duration Min"
     },
     "loop": {
      "type": "boolean",
      "title": "Loop",
      "default": true
     },
     "pass_by": {
      "items": {
       "type": "string",
       "enum": [
        "park",
        "fountain",
        "bench",
        "supermarket",
        "dog_area",
        "playground"
       ]
      },
      "type": "array",
      "title": "Pass By",
      "default": []
     },
     "avoid": {
      "items": {
       "type": "string",
       "enum": [
        "traffic",
        "hills"
       ]
      },
      "type": "array",
      "title": "Avoid",
      "default": []
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "activity"
    ],
    "title": "AssistantParams",
    "description": "Esquema cerrado de F6 (RF-21). La interpretacion (OCI Language + diccionario) solo puede rellenar esto."
   },
   "AssistantRouteRequest": {
    "properties": {
     "origin": {
      "$ref": "#/components/schemas/Coordinate"
     },
     "params": {
      "$ref": "#/components/schemas/AssistantParams"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
