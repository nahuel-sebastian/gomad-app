      "minimum": -90.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "lat",
     "lon"
    ],
    "title": "Coordinate"
