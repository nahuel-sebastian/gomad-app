       },
       {
        "type": "null"
       }
      ],
      "title": "Date"
     },
     "own_criterion": {
      "type": "boolean",
      "title": "Own Criterion",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "source",
     "label",
     "date"
    ],
    "title": "DataSource"
   },
   "DestinationSummary": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
