# Copiar a .env y rellenar. .env no se sube al repositorio.

# AEMET OpenData: clave gratuita, se pide por correo en https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=
# Municipios a pedir cada hora: 'todos' (179) o codigos INE separados por comas. Ajustar a la cuota real (Task 4).
AEMET_MUNICIPALITIES=todos
# Pausa entre municipios, en segundos (cada municipio son 2 peticiones). Comprobado el 14/10: tras 6 peticiones
# seguidas, la siguiente (~1 min despues) dio 429; ~100 s mas tarde respondio. Ventana exacta sin determinar.
# 10 s = ~6 peticiones/min, los 179 municipios en ~33 min (provisional, pendiente de decidir: ver CLAUDE.md 7.1).
AEMET_PAUSE_S=10

# Proveedor de IA para F6 (asistente de rutas). Por decidir: OCI Generative AI (Oracle) u otro.
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=

# Oracle (cuenta del equipo). Rellenar solo si se usa Autonomous Database / OCI.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
# Ruta al wallet descargado de la consola de Autonomous Database (no subirlo al repositorio)
ORACLE_WALLET_DIR=

# Dominio publico de la app (VM). Con dominio, Caddy saca el certificado HTTPS de Let's Encrypt.
# Sin definir (linea comentada): solo HTTP en el puerto 80 (pruebas en local). No dejar `DOMAIN=` vacio: Caddy no arranca.
#DOMAIN=gomad.example.org
