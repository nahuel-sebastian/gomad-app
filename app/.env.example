# Copiar a .env y rellenar. .env no se sube al repositorio.

# Prevision del tiempo: Open-Meteo (DEC-16), sin clave. No hace falta nada aqui.

# Proveedor de IA para F6 (asistente de rutas). DEC-03 (15/10): oci_language (OCI Language, sin LLM).
# IA_PROVEEDOR elige el adaptador de ai/. Sin credenciales de OCI el asistente usa solo el diccionario.
# IA_API_KEY e IA_MODELO no aplican a OCI Language: vacias.
IA_PROVEEDOR=oci_language
IA_API_KEY=
IA_MODELO=
# OCI Language: compartimento, region (eu-madrid-1) y ruta al fichero de configuracion del SDK de OCI
# (su clave privada tampoco se sube). En local sin Docker: la ruta del anfitrion (p. ej. /home/<usuario>/.oci/config).
# Con Docker (y en la VM) el compose monta ~/.oci en /oci:ro y fija OCI_CONFIG_FILE=/oci/config: el key_file
# de ese config debe ser /oci/<clave>.pem.
OCI_COMPARTMENT_ID=
OCI_REGION=
OCI_CONFIG_FILE=

# Oracle (cuenta del equipo). Rellenar solo si se usa Autonomous Database / OCI.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
# Ruta al wallet descargado de la consola de Autonomous Database (no subirlo al repositorio)
ORACLE_WALLET_DIR=

# DOMAIN (dominio publico de Caddy) no va aqui: va en app/deploy/.env (ver app/deploy/.env.example)
