# Copiar a .env y rellenar. .env no se sube al repositorio.

# AEMET OpenData: clave gratuita, se pide por correo en https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Proveedor de IA para F6 (asistente de rutas). Por decidir: OCI Generative AI (Oracle) u otro.
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=

# Oracle (cuenta del equipo). Rellenar solo si se usa Autonomous Database / OCI.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
# Ruta al wallet descargado de la consola de Autonomous Database (no subirlo al repositorio)
ORACLE_WALLET_DIR=
